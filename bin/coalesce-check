#!/usr/bin/env python3
"""Evidence trail for the coalescing layer's session-start check.

The run log's source_sha cues are the layer's retrieval contract, and
until this gate they were unchecked prose — the 2026-07-28 field audit
found cues that resolve locally but not in published history. This tool:

  1. verifies every `<sha>` cited in docs/coalescing.md resolves
     (`git cat-file -e`);
  2. verifies every `git show <sha>:<path>` cue's path exists at that
     SHA;
  3. checks each SHA against the published remote (origin), reporting
     `local-only pin` where it does not resolve there — a cue that
     survives only on one machine is a claim the world cannot verify;
  4. derives the lessons-tier count with the documented derivation so a
     session-start check can quote real numbers.

Scope note: this governs the **documentation ledger** per [DOM-14]. It
is unrelated to Engram's product memory coalescing (moments → episodes
→ arcs), which lives in `engram/core/coalesce.py`.

Adopted from agent-guidance @ `cec5666` via
`docs/plans/2026-07-28-agent-guidance-propagation-plan.md`. Adapted:
the sibling list is retargeted from Engram's perspective (agent-guidance
is the sibling whose SHAs this run log cites), and the lessons
derivation matches this repo's declared format — dated bullets with a
trailing colon, per `skills/coalescing/SKILL.md` step 1.

Read-only by construction. Exit 1 only on an unresolvable local cue
(a broken retrieval contract); local-only pins and count reports are
informational — publication discipline is the owner's call.
"""
from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
STATE = REPO_ROOT / "docs" / "coalescing.md"

SHA_RE = re.compile(r"`([0-9a-f]{7,40})`")
CUE_RE = re.compile(r"git show ([0-9a-f]{7,40}):([A-Za-z0-9_./-]+)")


SIBLINGS = ["agent-theory", "mm", "weft", "taut", "backstitch", "simplebroker"]
SIBLING_ROOT = REPO_ROOT.parent


def git(*args: str, repo: Path | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(["git", "-C", str(repo or REPO_ROOT), *args],
                          capture_output=True, text=True)


def resolve_anywhere(sha: str) -> str | None:
    r"""A SHA claim is satisfied when it resolves in an identifiable repo:
    this one first, then each sibling. The state file's propagation rows
    cite evidence across several repos in one cell, so per-occurrence
    context attribution is unreliable; resolve-anywhere matches the actual
    cue contract (retrievable somewhere identified)."""
    if git("cat-file", "-e", f"{sha}^{{commit}}").returncode == 0:
        return "local"
    for name in SIBLINGS:
        cand = SIBLING_ROOT / name
        if (cand / ".git").exists():
            if git("cat-file", "-e", f"{sha}^{{commit}}", repo=cand).returncode == 0:
                return name
    return None


def main() -> int:
    if not STATE.is_file():
        print("coalesce-check: no docs/coalescing.md — nothing to check")
        return 0
    text = STATE.read_text()

    sha_hits = [(m.group(1), m.start()) for m in SHA_RE.finditer(text)]
    # A SHA may appear many times; verify each occurrence in its own context.
    cues = sorted(set(CUE_RE.findall(text)))

    remote_ok = git("rev-parse", "--verify", "origin/HEAD").returncode == 0 or \
        git("rev-parse", "--verify", "origin/main").returncode == 0

    broken, local_only, sibling_ok = [], [], 0
    seen = set()
    for sha, _pos in sha_hits:
        if sha in seen:
            continue
        seen.add(sha)
        where = resolve_anywhere(sha)
        if where is None:
            broken.append(f"`{sha}` does not resolve locally or in any sibling")
        elif where != "local":
            sibling_ok += 1
        elif remote_ok:
            r = git("merge-base", "--is-ancestor", sha, "origin/main")
            if r.returncode != 0:
                local_only.append(sha)

    for sha, path in cues:
        r = git("cat-file", "-e", f"{sha}:{path}")
        if r.returncode != 0:
            broken.append(f"cue `git show {sha}:{path}` does not resolve")

    # Lessons-tier derivation. This repo's declared format (see
    # skills/coalescing/SKILL.md step 1) is dated bullets with a trailing
    # colon, nested under themed `###` sections.
    lessons = REPO_ROOT / "docs" / "lessons.md"
    count = 0
    if lessons.is_file():
        count = len(re.findall(r"^- 20[0-9]{2}-[0-9]{2}-[0-9]{2}:",
                               lessons.read_text(), re.M))

    print(f"coalesce-check: {len(seen)} SHA claim(s) ({sibling_ok} verified in "
          f"siblings), {len(cues)} retrieval cue(s); lessons dated entries: {count}")
    if local_only:
        print(f"  local-only pin ({len(local_only)}): " + ", ".join(local_only)
              + "  [not in origin/main — published history cannot verify these]")
    if broken:
        print(f"  BROKEN ({len(broken)}):")
        for b in broken:
            print(f"    {b}")
        return 1
    print("  all cues resolve locally"
          + ("" if remote_ok else "  [no origin remote — publication check skipped]"))
    return 0


if __name__ == "__main__":
    sys.exit(main())
